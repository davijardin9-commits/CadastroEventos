<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CadastroEventos.Views.ResumoPage"
    Title="Resumo do Evento"
    BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="18">

            <Label
                Text="EVENTO CADASTRADO!"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#1D4ED8"
                HorizontalOptions="Center"/>

            <Frame
                BackgroundColor="White"
                CornerRadius="15"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <Label Text="RESUMO DO EVENTO"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1D4ED8"/>

                    <Label Text="Nome do evento"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding Nome}"
                           FontSize="17"/>

                    <Label Text="Data de início"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"/>

                    <Label Text="Data de término"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}"/>

                    <Label Text="Duração do evento"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding Duracao.Days, StringFormat='{0} dias'}"/>

                    <Label Text="Número de participantes"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding NumeroParticipantes}"/>

                    <Label Text="Local do evento"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding Local}"/>

                    <Label Text="Custo por participante"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding CustoPorParticipante, StringFormat='R$ {0:N2}'}"/>

                    <BoxView HeightRequest="2"
                             Color="#DBEAFE"/>

                    <Label Text="CUSTO TOTAL DO EVENTO"
                           FontAttributes="Bold"
                           TextColor="#1D4ED8"/>

                    <Label
                        Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#16A34A"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
