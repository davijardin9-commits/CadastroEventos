<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CadastroEventos.MainPage"
    Title="Cadastro de Eventos"
    BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label
                Text="CADASTRO DE EVENTOS"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="#1D4ED8"
                HorizontalOptions="Center"/>

            <Label
                Text="Preencha as informações do evento"
                FontSize="14"
                TextColor="Gray"
                HorizontalOptions="Center"/>

            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="18"
                   HasShadow="True">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Nome do evento"
                           FontAttributes="Bold"/>

                    <Entry x:Name="NomeEntry"
                           Placeholder="Digite o nome do evento"/>

                    <Label Text="Data de início"
                           FontAttributes="Bold"/>

                    <DatePicker x:Name="DataInicioPicker"
                                Format="dd/MM/yyyy"/>

                    <Label Text="Data de término"
                           FontAttributes="Bold"/>

                    <DatePicker x:Name="DataTerminoPicker"
                                Format="dd/MM/yyyy"/>

                    <Label Text="Número de participantes"
                           FontAttributes="Bold"/>

                    <Entry x:Name="ParticipantesEntry"
                           Placeholder="Ex: 100"
                           Keyboard="Numeric"/>

                    <Label Text="Local do evento"
                           FontAttributes="Bold"/>

                    <Entry x:Name="LocalEntry"
                           Placeholder="Digite o local"/>

                    <Label Text="Custo por participante (R$)"
                           FontAttributes="Bold"/>

                    <Entry x:Name="CustoEntry"
                           Placeholder="Ex: 50,00"
                           Keyboard="Numeric"/>

                    <Button
                        x:Name="CadastrarButton"
                        Text="CADASTRAR EVENTO"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="CadastrarButton_Clicked"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
